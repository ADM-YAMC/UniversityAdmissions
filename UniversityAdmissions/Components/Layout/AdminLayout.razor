@inherits LayoutComponentBase
<div class="min-h-screen bg-slate-50">
    <header class="fixed left-0 top-0 z-50 w-full bg-[#103C73] text-white shadow-md">
        <div class="mx-auto flex min-h-20 max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
            <a href="/admin/admissions" class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#C9AA06] text-xl font-bold text-white">
                    U
                </div>
                <div>
                    <p class="text-lg font-bold tracking-wide">UNIVERSITY</p>
                    <p class="text-xs text-blue-100">Sistema de Admisiones</p>
                </div>
            </a>
            <div class="flex items-center gap-5">
                <a href="/admin/admissions" class="text-sm font-medium text-blue-100 transition hover:text-white">
                    Solicitudes
                </a>
                <form method="post" action="/admin/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="rounded-lg border border-white/30 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/10">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    </header>
    <main class="mx-auto max-w-7xl px-5 pb-10 sm:px-8" style="padding-top: 120px;">
        @Body
    </main>
</div>
