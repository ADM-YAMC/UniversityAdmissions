@page "/admin/admissions"
@using UniversityAdmissions.Application.DTOs.Admissions
@using UniversityAdmissions.Application.Interfaces.Services
@attribute [Authorize(Policy = Permissions.ViewAdmissions)]
@layout AdminLayout
@inject IAdmissionService AdmissionService
<PageTitle>Solicitudes de admisión</PageTitle>
<div class="mx-auto max-w-7xl">
    <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-[#1D4F95]">Solicitudes de admisión</h1>
        </div>
        <button type="button" @onclick="LoadAsync" disabled="@loading" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
            <span>Actualizar</span>
        </button>
    </div>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid gap-4 border-b border-slate-200 p-5 sm:grid-cols-2">
            <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Buscar solicitud</label>
                <input type="text" value="@search" @oninput="SearchChanged" placeholder="Nombre, identificación o número" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none transition focus:border-[#2A73C6] focus:ring-1 focus:ring-[#2A73C6]" />
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-slate-700">Estado</label>
                <select value="@status" @onchange="StatusChanged" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[#2A73C6] focus:ring-1 focus:ring-[#2A73C6]">
                    <option value="">Todos los estados</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En revisión">En revisión</option>
                    <option value="Aprobada">Aprobada</option>
                    <option value="Rechazada">Rechazada</option>
                </select>
            </div>
        </div>
        @if (loading)
        {
            <div class="flex min-h-48 items-center justify-center p-8">
                <p class="text-sm text-slate-500">Cargando solicitudes...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="p-8 text-center">
                <p class="text-sm text-red-700">@error</p>
                <button type="button" @onclick="LoadAsync" class="mt-4 text-sm font-semibold text-[#1D4F95] hover:underline">Intentar nuevamente</button>
            </div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="flex min-h-48 flex-col items-center justify-center p-8 text-center">
                <p class="font-semibold text-slate-700">No se encontraron solicitudes</p>
                <p class="mt-2 text-sm text-slate-500">No hay solicitudes que coincidan con los filtros seleccionados.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-600">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 font-semibold">Número</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 font-semibold">Aspirante</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 font-semibold">Identificación</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 font-semibold">Fecha</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 font-semibold">Estado</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-4 text-right font-semibold">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Paged)
                        {
                            <tr @key="item.Id" class="transition hover:bg-slate-50">
                                <td class="whitespace-nowrap px-5 py-4 font-semibold text-[#1D4F95]">
                                    #@item.Id
                                </td>
                                <td class="px-5 py-4 font-medium text-slate-800">
                                    @item.Applicant?.FirstName @item.Applicant?.LastName
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-slate-600">
                                    @item.Applicant?.IdentificationNumber
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-slate-600">
                                    @item.ApplicationDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="whitespace-nowrap px-5 py-4">
                                    <StatusBadge Status="@item.Status" />
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-right">
                                    <a href="@($"/admin/admissions/{item.Id}")" class="inline-flex items-center justify-center rounded-lg bg-blue-50 px-4 py-2 text-xs font-semibold text-[#1D4F95] transition hover:bg-blue-100">
                                        Ver detalles
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 px-5 py-4">
                <p class="text-xs text-slate-500">
                    Mostrando @FirstItem-@LastItem de @Filtered.Count solicitudes
                </p>
                <div class="flex items-center gap-3">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Anterior
                    </button>
                    <span class="whitespace-nowrap text-sm text-slate-600">
                        Página @currentPage de @TotalPages
                    </span>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Siguiente
                    </button>
                </div>
            </div>
        }
    </div>
</div>
@code {
    private List<AdmissionDto> admissions = new();
    private string search = string.Empty;
    private string status = string.Empty;
    private string? error;
    private bool loading = true;
    private int currentPage = 1;
    private const int PageSize = 10;
    private List<AdmissionDto> Filtered => admissions
        .Where(x => (string.IsNullOrWhiteSpace(status) || string.Equals(x.Status, status, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(search) ||
            x.Id.ToString().Contains(search, StringComparison.OrdinalIgnoreCase) ||
            $"{x.Applicant?.FirstName} {x.Applicant?.LastName}".Contains(search, StringComparison.OrdinalIgnoreCase) ||
            (x.Applicant?.IdentificationNumber?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderByDescending(x => x.ApplicationDate)
        .ToList();
    private IEnumerable<AdmissionDto> Paged => Filtered
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private int FirstItem => Filtered.Count == 0 ? 0 : (currentPage - 1) * PageSize + 1;
    private int LastItem => Math.Min(currentPage * PageSize, Filtered.Count);
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            var result = await AdmissionService.GetAllAsync();
            if (!result.Success)
            {
                error = string.Join(" ", result.Errors ?? new List<string>());
                if (string.IsNullOrWhiteSpace(error)) error = "No fue posible consultar las solicitudes.";
                admissions.Clear();
                return;
            }
            admissions = result.DataList?.ToList() ?? new();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            error = "Ocurrió un error al consultar las solicitudes.";
            admissions.Clear();
        }
        finally
        {
            loading = false;
        }
    }
    private void SearchChanged(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }
    private void StatusChanged(ChangeEventArgs e)
    {
        status = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }
    private void PreviousPage()
    {
        if (currentPage > 1) currentPage--;
    }
    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }
}
